{
  "version": 1,
  "sdk_version": "3.5.0",
  "path": "/mcp",
  "auth": {
    "type": "oauth",
    "issuer": "https://kpgeusobewjzkytxycbj.supabase.co/auth/v1",
    "accepted_audiences": [
      "authenticated"
    ]
  },
  "mcp": {
    "server": {
      "name": "spend-sense-savings-spark",
      "version": "0.1.0",
      "title": "Spend Sense Savings Spark"
    },
    "tools": [
      {
        "name": "get_money_snapshot",
        "title": "Get money snapshot",
        "description": "Summarise the signed-in user's month: income, spending, savings, top categories, why they spent (need/want/impulse/social), budgets, goals and FinWise's rule-based insights. Amounts are in INR.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "month": {
              "description": "Month as YYYY-MM. Defaults to the current month.",
              "type": "string",
              "pattern": "^\\d{4}-(0[1-9]|1[0-2])$"
            }
          },
          "additionalProperties": false
        },
        "outputSchema": null
      },
      {
        "name": "list_transactions",
        "title": "List transactions",
        "description": "List the signed-in user's recent transactions, newest first, optionally filtered by month, type or category.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "month": {
              "description": "Only this month, as YYYY-MM.",
              "type": "string",
              "pattern": "^\\d{4}-(0[1-9]|1[0-2])$"
            },
            "type": {
              "description": "Only income or only expenses.",
              "type": "string",
              "enum": [
                "income",
                "expense"
              ]
            },
            "category": {
              "description": "Exact category name, e.g. 'Food & Dining'.",
              "type": "string",
              "maxLength": 60
            },
            "limit": {
              "description": "Maximum rows to return (default 50).",
              "type": "integer",
              "minimum": 1,
              "maximum": 200
            }
          },
          "additionalProperties": false
        },
        "outputSchema": null
      },
      {
        "name": "list_budgets",
        "title": "List budgets",
        "description": "Show the signed-in user's category budgets for a month with amount spent and status (ok, warning, over).",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "month": {
              "description": "Month as YYYY-MM. Defaults to the current month.",
              "type": "string",
              "pattern": "^\\d{4}-(0[1-9]|1[0-2])$"
            }
          },
          "additionalProperties": false
        },
        "outputSchema": null
      },
      {
        "name": "list_savings_goals",
        "title": "List savings goals",
        "description": "Show the signed-in user's savings goals with target, amount saved, progress and target date.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {},
          "additionalProperties": false
        },
        "outputSchema": null
      },
      {
        "name": "add_transaction",
        "title": "Add transaction",
        "description": "Record an income or expense for the signed-in user. Never include PINs, OTPs, passwords or card numbers in the merchant or note.",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": false,
          "idempotentHint": false,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "income",
                "expense"
              ],
              "description": "income or expense."
            },
            "amount": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 10000000,
              "description": "Amount in INR."
            },
            "category": {
              "type": "string",
              "description": "Expense categories: Food & Dining, Transport, Shopping, Entertainment, Subscriptions, Education, Bills & Recharge, Health, Gifts & Social, Other. Income categories: Pocket money, Stipend / Salary, Freelance, Gifts received, Other income."
            },
            "occurred_on": {
              "description": "Date as YYYY-MM-DD. Defaults to today.",
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
            },
            "merchant": {
              "description": "Where the money went or came from.",
              "type": "string",
              "maxLength": 80
            },
            "payment_method": {
              "description": "How it was paid (default upi).",
              "type": "string",
              "enum": [
                "upi",
                "card",
                "cash",
                "bank",
                "wallet",
                "other"
              ]
            },
            "spend_reason": {
              "description": "Why the user spent it (expenses only).",
              "type": "string",
              "enum": [
                "need",
                "want",
                "impulse",
                "social"
              ]
            },
            "note": {
              "description": "Optional short note.",
              "type": "string",
              "maxLength": 240
            }
          },
          "required": [
            "type",
            "amount",
            "category"
          ],
          "additionalProperties": false
        },
        "outputSchema": null
      }
    ]
  }
}
